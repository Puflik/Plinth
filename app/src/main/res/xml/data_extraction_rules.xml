<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (C4, план 17.5, уровень 4): и в облачную копию, и при переносе
  на новый телефон идёт только журнал пользовательских данных —
  files/core/journal. База, кэш, идентификатор установки, замок и настройки
  не идут: каталог вернёт скан, а ссылки базы на новом телефоне указывали
  бы на чужие файлы (ревью №7). Облачная копия — только с шифрованием на
  устройстве: журнал хранит историю прослушиваний.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="core/journal/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="core/journal/" />
    </device-transfer>
</data-extraction-rules>
