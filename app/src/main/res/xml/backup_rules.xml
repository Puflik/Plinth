<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 и старше (C4, план 17.5, уровень 4): в копию Google Drive идёт
  только журнал пользовательских данных — files/core/journal. База, кэш,
  идентификатор установки (files/core/device), замок и настройки не идут:
  каталог вернёт скан, а восстановленный журнал не делает новую установку
  старой. Правило с <include> берёт только перечисленное. Копия — только
  с шифрованием на устройстве (Android 9+): журнал хранит историю
  прослушиваний. Папка aside/ с копиями испорченных файлов журнала (Р9е)
  исключена: их никто не читает, и они не должны занимать квоту 25 МБ.
-->
<full-backup-content>
    <include domain="file" path="core/journal/" requireFlags="clientSideEncryption" />
    <exclude domain="file" path="core/journal/aside/" />
</full-backup-content>
