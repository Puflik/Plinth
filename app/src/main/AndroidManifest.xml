<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Чтение музыки для библиотеки (C1.1): с Android 13 — только аудио,
      раньше — всё общее хранилище. Файл через SAF по-прежнему открывается
      без разрешений.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Разрешения фонового воспроизведения. Нужны эпику B3 (шаг 4 вертикали);
      объявлены здесь, потому что состав разрешений — ответственность A2.1.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
      Резервной копии и переноса нет (ревью №7): ссылки очереди и базы на
      новом телефоне указывают на чужие файлы, а мастер обещает, что ничего не
      покидает устройство. На Android 12+ allowBackup="false" не выключает
      перенос «телефон → телефон» — его закрывают data_extraction_rules.
    -->
    <application
        android:name=".PlinthApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Plinth">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Plinth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Фоновое воспроизведение (B3.1). exported — чтобы к сессии могли
          подключиться системные пульты: уведомление, Bluetooth, экран блокировки.
        -->
        <service
            android:name=".audio.media3.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          Медиакнопка, когда службы уже нет (ревью №12): после паузы система
          закрывает службу, и без приёмника «play» на гарнитуре уходил в никуда.
          Приёмник Media3 поднимает PlaybackService, возобновление — в ней.
        -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!--
          WorkManager настраивает PlinthApplication (воркеры строит Hilt),
          поэтому автоматическая инициализация при старте выключена.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
